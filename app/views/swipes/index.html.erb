<h1 class="visually-hidden">Découvrir</h1>

<% guest_link = current_user ? {} : { href: new_user_registration_path, label: t("swipes.taste_profile.save_link") } %>

<% if @animes.any? %>
  <div class="na-swipe-page">
    <div class="na-swipe-page__side na-swipe-page__side--start">
      <%= render Organisms::TasteProfilePanelComponent.new(**guest_link) %>
    </div>
    <div class="na-swipe-page__main">
      <%= render Organisms::SwipeDeckComponent.new(animes: @animes) %>
    </div>
    <div class="na-swipe-page__side na-swipe-page__side--end">
      <%= render Organisms::SwipeHistoryPanelComponent.new(recommendations_href: recommendations_path) %>
    </div>
  </div>
<% elsif @deck_finished %>
  <%= render Molecules::DeckFinishedComponent.new(recommendations_href: recommendations_path) %>
<% else %>
  <p class="text-body-secondary text-center"><%= t("swipes.deck.empty") %></p>
<% end %>
