<% reset_url = edit_password_url(@resource, reset_password_token: @token) %>
<% validity = distance_of_time_in_words(Time.current, Devise.reset_password_within.from_now) %>
<% content_for :title, "Réinitialise ton mot de passe · NextAnime" %>
<% content_for :preheader, "Choisis un nouveau mot de passe en un clic. Le lien reste valable #{validity}." %>
<% content_for :footer do %>
  <p style="margin:0;">Cet e-mail a été envoyé à <%= @resource.email %> parce que quelqu'un a demandé à changer le mot de passe de ce compte NextAnime.</p>
<% end %>

<h1 style="<%= mail_style(:heading) %>">Réinitialise ton mot de passe</h1>

<p style="<%= mail_style(:paragraph) %>">Salut <%= @resource.email %>,</p>
<p style="<%= mail_style(:paragraph) %>">Tu as demandé à changer ton mot de passe NextAnime. Clique sur le bouton ci-dessous pour en choisir un nouveau. Le lien reste valable <strong><%= validity %></strong>.</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0;">
  <tr>
    <td align="center" bgcolor="<%= mail_color(:magenta) %>" style="<%= mail_style(:button_cell) %>">
      <%= link_to "Choisir un nouveau mot de passe", reset_url, style: mail_style(:button), data: { role: "cta" } %>
    </td>
  </tr>
</table>

<p style="<%= mail_style(:muted) %>">Le bouton ne fonctionne pas ? Copie ce lien dans ton navigateur :</p>
<p style="margin:0;"><%= link_to reset_url, reset_url, style: mail_style(:link), data: { role: "fallback-link" } %></p>

<p style="<%= mail_style(:note) %>">Si tu n'es pas à l'origine de cette demande, ignore simplement cet e-mail : ton mot de passe ne changera pas.</p>
