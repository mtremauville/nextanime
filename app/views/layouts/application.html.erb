<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
  <%= render "layouts/head" %>

  <body>
    <a class="visually-hidden-focusable" href="#main">Aller au contenu</a>

    <%= render Organisms::MainNavigationComponent.new(current_path: request.path, user: current_user, selected_country: current_country_code) %>

    <%= render Molecules::GuestBannerComponent.new unless current_user || devise_controller? || current_page?(root_path) %>

    <main tabindex="-1" id="main" class="container na-main">
      <%= render "shared/flash" %><%= yield %>
    </main>

    <%= render Organisms::SiteFooterComponent.new %>
  </body>
</html>
