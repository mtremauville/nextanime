<%= turbo_stream.append Organisms::CatalogueGridComponent::DOM_ID do %>
  <%= render Organisms::CatalogueItemsComponent.new(animes: @page.animes, scorer: @scorer) %>
<% end %>

<%= turbo_stream.replace Molecules::LoadMoreComponent::DOM_ID do %>
  <%= render partial: "animes/load_more", formats: [ :html ], locals: { page: @page } %>
<% end %>
