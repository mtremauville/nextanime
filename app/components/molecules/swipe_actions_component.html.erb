<div class="na-swipe-actions">
  <div class="na-swipe-actions__item">
    <button type="button" class="na-swipe-actions__button na-swipe-actions__button--pass"
            data-action="swipe-deck#pass"
            aria-label="<%= I18n.t("swipes.actions.pass_label") %>">
      <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
    <span class="na-swipe-actions__label"><%= I18n.t("swipes.actions.pass") %></span>
  </div>
  <div class="na-swipe-actions__item">
    <button type="button" class="na-swipe-actions__button na-swipe-actions__button--like"
            data-action="swipe-deck#like"
            aria-label="<%= I18n.t("swipes.actions.like_label") %>">
      <i class="bi bi-heart-fill" aria-hidden="true"></i>
    </button>
    <span class="na-swipe-actions__label"><%= I18n.t("swipes.actions.like") %></span>
  </div>
</div>
<p class="na-swipe-actions__hint"><%= I18n.t("swipes.actions.hint") %></p>
