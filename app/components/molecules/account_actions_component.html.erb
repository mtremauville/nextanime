<div class="na-account">
  <% if user %>
    <%= render Atoms::AvatarComponent.new(name: user.email) %>
    <span class="visually-hidden">Connecté en tant que <%= user.email %></span>
    <%= button_to "Déconnexion", destroy_user_session_path, method: :delete, class: "btn na-account__signout" %>
  <% else %>
    <%= link_to "Connexion", new_user_session_path, class: "na-account__link" %>
    <%= render Atoms::ButtonComponent.new(variant: :outline, href: new_user_registration_path) do %>Créer un compte<% end %>
  <% end %>
</div>
