<li class="na-airing">
  <% if anime.cover_image_url %>
    <img class="na-airing__poster" src="<%= anime.cover_image_url %>" alt="" loading="lazy">
  <% else %>
    <div class="na-airing__poster na-poster--violet"></div>
  <% end %>
  <div class="na-airing__main">
    <%= link_to title, anime_path(anime), class: "na-airing__title" %>
    <p class="na-airing__episode"><%= episode_label %></p>
  </div>
  <time class="na-airing__time" datetime="<%= airing_time.iso8601 %>"><%= clock %></time>
</li>
