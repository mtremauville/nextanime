<div data-controller="confirm-modal">
  <dialog id="<%= modal_id %>" class="na-modal" aria-labelledby="<%= title_id %>"
          data-confirm-modal-target="dialog" data-action="click->confirm-modal#backdrop">
    <div class="na-modal__panel">
      <div class="na-modal__header">
        <span class="na-modal__icon" aria-hidden="true"><i class="bi bi-<%= icon %>"></i></span>
        <h2 id="<%= title_id %>" class="na-modal__title"><%= title %></h2>
      </div>

      <div class="na-modal__body"><%= content %></div>

      <div class="na-modal__actions">
        <%= render Atoms::ButtonComponent.new(variant: :outline, autofocus: true, data: { action: "confirm-modal#close" }) do %>Annuler<% end %>
        <%= form_with url: confirm_url, method: confirm_method, class: "na-modal__confirm" do %>
          <%= render Atoms::ButtonComponent.new(type: "submit", class: "w-100") do %><%= confirm_label %><% end %>
        <% end %>
      </div>
    </div>
  </dialog>
</div>
