<aside class="na-filters" aria-label="<%= t("catalogue.filters.title") %>">
  <div class="na-filters__header">
    <h2 class="na-filters__title"><%= t("catalogue.filters.title") %></h2>
    <%= link_to t("catalogue.filters.reset"), reset_path, class: "na-filters__reset" %>
  </div>

  <%= form_with url: action, method: :get, data: { controller: "auto-submit", action: "change->auto-submit#submit" } do %>
    <%= render Atoms::HiddenFieldsComponent.new(fields: carried) %>

    <%= render Molecules::FilterGroupComponent.new(name: "genre_ids", legend: t("catalogue.filters.genres"), options: genre_options, selected: filters.genre_ids) %>
    <%= render Molecules::FilterGroupComponent.new(name: "formats", legend: t("catalogue.filters.format"), options: format_options, selected: filters.formats, variant: :pills) %>
    <%= render Molecules::SelectFieldComponent.new(name: "season", label: t("catalogue.filters.season"), options: season_options, selected: filters.season, blank: t("catalogue.filters.all_seasons")) %>

    <fieldset class="na-filter-group">
      <legend class="na-filter-group__legend"><%= t("catalogue.filters.years") %></legend>
      <div class="na-filters__years">
        <%= label_tag "filter-year-from", t("catalogue.filters.year_from"), class: "visually-hidden" %>
        <%= number_field_tag "year_from", filters.year_from, id: "filter-year-from", min: 1900, class: "form-control" %>
        <span aria-hidden="true">–</span>
        <%= label_tag "filter-year-to", t("catalogue.filters.year_to"), class: "visually-hidden" %>
        <%= number_field_tag "year_to", filters.year_to, id: "filter-year-to", min: 1900, class: "form-control" %>
      </div>
    </fieldset>

    <%= render Molecules::FilterGroupComponent.new(name: "statuses", legend: t("catalogue.filters.status"), options: status_options, selected: filters.statuses) %>

    <%= submit_tag t("catalogue.filters.apply"), name: nil, class: "btn btn-primary w-100 na-filters__apply" %>
  <% end %>
</aside>
