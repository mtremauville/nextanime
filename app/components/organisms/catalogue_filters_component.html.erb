<%= tag.public_send(wrapper_tag, class: class_names("na-filters", "na-filters--sheet": sheet?), aria: { label: wrapper_label }) do %>
  <% unless sheet? %>
    <div class="na-filters__header">
      <h2 class="na-filters__title"><%= t("catalogue.filters.title") %></h2>
      <%= link_to t("catalogue.filters.reset"), reset_path, class: "na-filters__reset" %>
    </div>
  <% end %>

  <%= form_with url: action, method: :get, class: "na-filters__form", data: form_data do %>
    <div class="na-filters__body">
      <%= render Atoms::HiddenFieldsComponent.new(fields: carried) %>

      <%= render Molecules::FilterGroupComponent.new(name: "genre_ids", legend: t("catalogue.filters.genres"), options: genre_options, selected: filters.genre_ids, variant: group_variant, id_prefix: id_prefix) %>
      <%= render Molecules::FilterGroupComponent.new(name: "formats", legend: t("catalogue.filters.format"), options: format_options, selected: filters.formats, variant: :pills, id_prefix: id_prefix) %>
      <%= render Molecules::FilterGroupComponent.new(name: "studio_ids", legend: t("catalogue.filters.studios"), search_label: t("catalogue.filters.studio_search"), no_match_text: t("catalogue.filters.no_studio"), options: studio_options, selected: filters.studio_ids, variant: group_variant, id_prefix: id_prefix) %>
      <%= render Molecules::SelectFieldComponent.new(name: "season", label: t("catalogue.filters.season"), options: season_options, selected: filters.season, blank: t("catalogue.filters.all_seasons"), id_prefix: id_prefix) %>

      <fieldset class="na-filter-group">
        <legend class="na-filter-group__legend"><%= t("catalogue.filters.years") %></legend>
        <div class="na-filters__years">
          <%= label_tag "#{id_prefix}-year-from", t("catalogue.filters.year_from"), class: "visually-hidden" %>
          <%= number_field_tag "year_from", filters.year_from, id: "#{id_prefix}-year-from", min: 1900, class: "form-control" %>
          <span aria-hidden="true">–</span>
          <%= label_tag "#{id_prefix}-year-to", t("catalogue.filters.year_to"), class: "visually-hidden" %>
          <%= number_field_tag "year_to", filters.year_to, id: "#{id_prefix}-year-to", min: 1900, class: "form-control" %>
        </div>
      </fieldset>

      <%= render Molecules::FilterGroupComponent.new(name: "statuses", legend: t("catalogue.filters.status"), options: status_options, selected: filters.statuses, variant: group_variant, id_prefix: id_prefix) %>
    </div>

    <% if sheet? %>
      <div class="na-filters__footer">
        <%= render(Atoms::ButtonComponent.new(variant: :outline, href: reset_path)) { t("catalogue.filters.reset") } %>
        <%= submit_tag t("catalogue.filters.show_results"), name: nil, class: "btn btn-primary na-filters__show" %>
      </div>
    <% else %>
      <%= submit_tag t("catalogue.filters.apply"), name: nil, class: "btn btn-primary w-100 na-filters__apply" %>
    <% end %>
  <% end %>
<% end %>
