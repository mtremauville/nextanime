<aside class="na-filters" aria-label="<%= t("catalogue.filters.title") %>">
  <h2 class="na-filters__title"><%= t("catalogue.filters.title") %></h2>

  <%= form_with url: action, method: :get do %>
    <% if search.present? %>
      <%= hidden_field_tag Molecules::SearchFieldComponent::PARAM, search, id: nil %>
    <% end %>

    <%= render Molecules::FilterGroupComponent.new(name: "genre_ids", legend: t("catalogue.filters.genres"), options: genre_options, selected: filters.genre_ids) %>
    <%= render Molecules::FilterGroupComponent.new(name: "formats", legend: t("catalogue.filters.format"), options: format_options, selected: filters.formats) %>
    <%= render Molecules::SelectFieldComponent.new(name: "season", label: t("catalogue.filters.season"), options: season_options, selected: filters.season, blank: t("catalogue.filters.all_seasons")) %>

    <fieldset class="na-filter-group">
      <legend class="na-filter-group__legend"><%= t("catalogue.filters.years") %></legend>
      <%= render Molecules::FormFieldComponent.new(name: "year_from", label: t("catalogue.filters.year_from"), type: "number", value: filters.year_from, min: 1900) %>
      <%= render Molecules::FormFieldComponent.new(name: "year_to", label: t("catalogue.filters.year_to"), type: "number", value: filters.year_to, min: 1900) %>
    </fieldset>

    <%= render Molecules::FilterGroupComponent.new(name: "statuses", legend: t("catalogue.filters.status"), options: status_options, selected: filters.statuses) %>

    <%= submit_tag t("catalogue.filters.apply"), name: nil, class: "btn btn-primary w-100" %>
  <% end %>
</aside>
