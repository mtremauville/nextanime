<%= form_with scope: :user, url: user_password_path, class: "na-auth-form" do %>
  <%= render Molecules::FormFieldComponent.new(name: "user[email]", label: "Adresse e-mail", type: "email", value: resource.email, autocomplete: "email", autofocus: true) %>

  <%= render Atoms::ButtonComponent.new(type: "submit", class: "w-100") do %>Envoyer le lien<% end %>

  <p class="text-center mt-4 mb-0">
    <%= link_to "Retour à la connexion", new_user_session_path, class: "na-auth-form__forgot" %>
  </p>
<% end %>
