<%= form_with scope: :user, url: user_password_path, method: :patch, class: "na-auth-form" do %>
  <% if token_error %>
    <%= render Molecules::AlertComponent.new(message: token_error, variant: :alert) %>
    <p>
      <%= link_to "Demander un nouveau lien", new_user_password_path, class: "na-auth-form__forgot" %>
    </p>
  <% end %>

  <%= hidden_field_tag "user[reset_password_token]", resource.reset_password_token, id: nil %>

  <%= render Molecules::FormFieldComponent.new(name: "user[password]", label: "Nouveau mot de passe", type: "password", hint: password_hint, error: error_for(:password), autocomplete: "new-password", autofocus: true) %>
  <%= render Molecules::FormFieldComponent.new(name: "user[password_confirmation]", label: "Confirmer le nouveau mot de passe", type: "password", error: error_for(:password_confirmation), autocomplete: "new-password") %>

  <%= render Atoms::ButtonComponent.new(type: "submit", class: "w-100") do %>Changer mon mot de passe<% end %>
<% end %>
