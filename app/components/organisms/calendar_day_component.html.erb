<%= tag.section(id: anchor, class: css_class, aria: { label: label }) do %>
  <h2 class="na-calendar-day__title"><% if day.today? %><span class="na-calendar-day__today-mark"><%= today_mark %></span> <% end %><span class="na-calendar-day__name"><%= name %></span> <span class="na-calendar-day__date"><%= number %><span class="na-calendar-day__month"> <%= month %></span></span></h2>
  <% if day.airings.empty? %>
    <p class="na-calendar-day__none"><%= nothing_airs_label %></p>
  <% else %>
    <ul class="na-calendar-day__list">
      <% day.airings.each do |anime| %>
        <%= render Molecules::AiringItemComponent.new(anime: anime, in_watchlist: in_watchlist?(anime)) %>
      <% end %>
    </ul>
  <% end %>
<% end %>
