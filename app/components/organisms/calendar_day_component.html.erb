<%= tag.section(id: anchor, class: css_class, aria: { label: label }) do %>
  <h2 class="na-calendar-day__title"><%= label %></h2>
  <% if day.airings.empty? %>
    <p class="na-calendar-day__none"><%= nothing_airs_label %></p>
  <% else %>
    <ul class="na-calendar-day__list">
      <% day.airings.each do |anime| %>
        <%= render Molecules::AiringItemComponent.new(anime: anime) %>
      <% end %>
    </ul>
  <% end %>
<% end %>
