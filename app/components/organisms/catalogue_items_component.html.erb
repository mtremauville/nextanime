<% animes.each do |anime| %>
  <% summary = summary_for(anime) %>
  <li class="na-catalogue-grid__item" data-role="catalogue-item">
    <%= render Molecules::PosterCardComponent.new(
          title: anime.display_title,
          href: anime_path(anime),
          meta: summary.line,
          match: scorer&.percentage(anime),
          image_url: anime.cover_image_url
        ) %>
  </li>
<% end %>
