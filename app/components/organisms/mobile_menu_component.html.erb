<dialog id="<%= DOM_ID %>" class="na-menu" aria-labelledby="mobile-menu-title"
        data-menu-target="dialog" data-action="click->menu#backdrop close->menu#closed">
  <div class="na-menu__panel">
    <div class="na-menu__header">
      <h2 id="mobile-menu-title" class="na-menu__title">Menu</h2>
      <button type="button" class="btn-na-outline na-icon-button"
              data-action="menu#close" aria-label="Fermer le menu">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </div>

    <% if user %>
      <div class="na-menu__account">
        <%= render Atoms::AvatarComponent.new(name: user.email) %>
        <span class="na-menu__account-email"><%= user.email %></span>
      </div>
    <% else %>
      <div class="na-menu__guest">
        <p class="na-menu__guest-title">Mode invité</p>
        <p class="na-menu__guest-text">Ton profil n'est pas sauvegardé : il disparaît si tu fermes la page.</p>
      </div>
    <% end %>

    <nav class="na-menu__nav" aria-label="Navigation mobile">
      <% items.each do |item| %>
        <%= render Molecules::NavItemComponent.new(**item) %>
      <% end %>
    </nav>

    <fieldset class="na-menu__section">
      <legend class="na-menu__section-title">Pays</legend>
      <% countries.each do |code, name| %>
        <label class="na-menu__choice">
          <%= radio_button_tag "menu_country", code, code == selected_country %>
          <span><%= name %></span>
        </label>
      <% end %>
    </fieldset>

    <fieldset class="na-menu__section">
      <legend class="na-menu__section-title">Thème</legend>
      <div class="na-menu__themes">
        <% THEMES.each do |theme, label| %>
          <button type="button" class="na-menu__theme"
                  data-controller="theme" data-action="theme#choose"
                  data-theme-theme-param="<%= theme %>"><%= label %></button>
        <% end %>
      </div>
    </fieldset>

    <div class="na-menu__actions">
      <% if user %>
        <%= button_to "Déconnexion", destroy_user_session_path, method: :delete, class: "btn btn-na-outline w-100" %>
      <% else %>
        <%= render Atoms::ButtonComponent.new(href: new_user_registration_path, class: "w-100") do %>Créer un compte<% end %>
        <%= render Atoms::ButtonComponent.new(variant: :outline, href: new_user_session_path, class: "w-100") do %>Connexion<% end %>
      <% end %>
    </div>
  </div>
</dialog>
